document.addEventListener('DOMContentLoaded', () => {
    const leftSidebar = document.getElementById('left-sidebar');
    const rightSidebar = document.getElementById('right-sidebar');
    const menuToggleBtn = document.getElementById('menu-toggle-btn');
    const profileToggleBtn = document.getElementById('profile-toggle-btn');
    const overlay = document.getElementById('overlay');
    const dashboardContent = document.getElementById('dashboard-content');
    const userAvatar = document.getElementById('user-avatar');
    //25,000

    const farmerId = window.farmerId;
    if (!farmerId) {
        window.location.href = '/login';
        return;
    }

    function initializeSmartCalendar() {
        const cropSelect = document.getElementById('crop-select');
        const sowingDateInput = document.getElementById('sowing-date');
        const generateBtn = document.getElementById('generate-btn');
        const calendarBody = document.getElementById('calendar-body');
        const monthYearDisplay = document.getElementById('month-year-display');
        const prevMonthBtn = document.getElementById('prev-month-btn');
        const nextMonthBtn = document.getElementById('next-month-btn');
        const todayBtn = document.getElementById('today-btn');
        const loadingSpinner = document.getElementById('loading-spinner');
        const buttonText = document.getElementById('button-text');
        const calendarCard = document.getElementById('calendar-card');
        const placeholderCard = document.getElementById('placeholder-card');
        const dayModal = document.getElementById('day-modal');
        const modalDate = document.getElementById('modal-date');
        const modalEventList = document.getElementById('modal-event-list');
        const addEventForm = document.getElementById('add-event-form');
        const eventDateInput = document.getElementById('event-date-input');
        const eventTitleInput = document.getElementById('event-title-input');
        const eventTypeSelect = document.getElementById('event-type-select');
        const taskListCard = document.getElementById('task-list-card');

        let currentDate = new Date();
        let generatedEvents = [];
        const eventColors = {
            'Fertilizer': { bg: 'bg-green-100', text: 'text-green-800', border: 'border-green-200', dot: 'bg-green-500' },
            'Irrigation': { bg: 'bg-blue-100', text: 'text-blue-800', border: 'border-blue-200', dot: 'bg-blue-500' },
            'Pest Control': { bg: 'bg-red-100', text: 'text-red-800', border: 'border-red-200', dot: 'bg-red-500' },
            'Weeding': { bg: 'bg-yellow-100', text: 'text-yellow-800', border: 'border-yellow-200', dot: 'bg-yellow-500' },
            'Harvesting': { bg: 'bg-purple-100', text: 'text-purple-800', border: 'border-purple-200', dot: 'bg-purple-500' },
            'Note': { bg: 'bg-gray-200', text: 'text-gray-900', border: 'border-gray-300', dot: 'bg-gray-500' },
            'Default': { bg: 'bg-gray-200', text: 'text-gray-900', border: 'border-gray-300', dot: 'bg-gray-500' }
        };
        const API_BASE_URL = '';

        function renderTaskList(events) {
            const taskListBody = document.getElementById('task-list-body');
            taskListBody.innerHTML = '';
            const sortedEvents = [...events].sort((a, b) => new Date(a.date) - new Date(b.date));
            if (sortedEvents.length === 0) {
                taskListBody.innerHTML = `<p class="text-gray-500">No tasks to display.</p>`;
                return;
            }
            sortedEvents.forEach((event, index) => {
                const colorInfo = eventColors[event.type] || eventColors['Default'];
                const eventDate = new Date(event.date + 'T00:00:00');
                const formattedDate = eventDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
                const listItemHTML = `
                    <div class="flex items-start gap-4 p-3 border-l-4 ${colorInfo.border} ${colorInfo.bg} rounded-r-lg">
                        <div class="flex-shrink-0 flex flex-col items-center justify-center pt-1">
                             <span class="w-3 h-3 rounded-full ${colorInfo.dot}"></span>
                             <span class="text-xs font-bold text-gray-500 mt-1">STEP ${index + 1}</span>
                        </div>
                        <div class="flex-grow">
                            <div class="flex justify-between items-baseline">
                                <p class="font-bold text-base ${colorInfo.text}">${event.title}</p>
                                <p class="text-sm font-medium text-gray-700">${formattedDate}</p>
                            </div>
                            ${event.description ? `<p class="text-sm text-gray-600 mt-1">${event.description}</p>` : ''}
                        </div>
                    </div>`;
                taskListBody.innerHTML += listItemHTML;
            });
        }

        function renderCalendar() {
            calendarBody.innerHTML = '';
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            monthYearDisplay.textContent = `${currentDate.toLocaleString('default', { month: 'long' })} ${year}`;
            const firstDayOfMonth = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const today = new Date();
            for (let i = 0; i < firstDayOfMonth; i++) {
                calendarBody.innerHTML += `<div class="border rounded-lg bg-gray-50/50"></div>`;
            }
            for (let day = 1; day <= daysInMonth; day++) {
                const isToday = day === today.getDate() && month === today.getMonth() && year === today.getFullYear();
                const todayClass = isToday ? 'border-green-500 bg-green-50' : 'border-gray-200';
                const dateString = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const dayEvents = generatedEvents.filter(e => e.date === dateString);
                let eventsHTML = '';
                dayEvents.forEach(event => {
                    const colorInfo = eventColors[event.type] || eventColors['Default'];
                    const colorClass = `${colorInfo.bg} ${colorInfo.text} ${colorInfo.border}`;
                    eventsHTML += `<div class="text-sm font-medium px-2 py-0.5 border rounded-md mb-1 truncate ${colorClass}">${event.title}</div>`;
                });
                calendarBody.innerHTML += `
                    <div class="relative h-24 sm:h-32 border rounded-lg p-1.5 ${todayClass} calendar-cell cursor-pointer hover:bg-gray-100 transition-colors" data-date="${dateString}" onclick="openDayModal('${dateString}')">
                        <span class="text-sm font-medium ${isToday ? 'text-green-600' : 'text-gray-700'}">${day}</span>
                        <div class="absolute bottom-1.5 left-1.5 right-1.5">${eventsHTML}</div>
                    </div>`;
            }
        }

        window.openDayModal = function(dateString) {
            const date = new Date(dateString + 'T00:00:00');
            modalDate.textContent = date.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            eventDateInput.value = dateString;
            const dayEvents = generatedEvents.filter(e => e.date === dateString);
            modalEventList.innerHTML = '';
            if (dayEvents.length > 0) {
                dayEvents.forEach((event, index) => {
                    const colorInfo = eventColors[event.type] || eventColors['Default'];
                    const colorClass = `${colorInfo.bg} ${colorInfo.text} ${colorInfo.border}`;
                    modalEventList.innerHTML += `
                        <div class="flex justify-between items-center p-2 rounded-md ${colorClass}">
                            <span>${event.title}</span>
                            <button onclick="deleteEvent('${dateString}', ${index})" class="p-1 rounded-full hover:bg-red-200">
                                <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-4v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>`;
                });
            } else {
                modalEventList.innerHTML = '<p class="text-gray-500">No tasks scheduled for this day.</p>';
            }
            dayModal.classList.remove('hidden');
        };

        window.closeDayModal = function() { dayModal.classList.add('hidden'); };

        window.deleteEvent = function(dateString, eventIndexInDay) {
            let count = -1;
            const globalIndex = generatedEvents.findIndex(event => {
                if (event.date === dateString) {
                    count++;
                    return count === eventIndexInDay;
                }
                return false;
            });
            if (globalIndex > -1) {
                generatedEvents.splice(globalIndex, 1);
                renderTaskList(generatedEvents);
                renderCalendar();
                window.closeDayModal();
            }
        };

        // Populate immediately from embedded seed data if available
        try {
            if (Array.isArray(window.SEED_CROPS) && window.SEED_CROPS.length > 0) {
                cropSelect.innerHTML = '<option value="">-- Choose a crop --</option>';
                window.SEED_CROPS.forEach(crop => {
                    const option = document.createElement('option');
                    option.value = crop.crop_id;
                    option.textContent = `${crop.crop_name} (${crop.variety})`;
                    cropSelect.appendChild(option);
                });
            }
        } catch (e) {}

        // Try fetching from API in background; override if successful
        (async () => {
            try {
                const response = await fetch(`/api/crops`);
                if (!response.ok) throw new Error('Network error, could not fetch crops.');
                const crops = await response.json();
                if (Array.isArray(crops) && crops.length > 0) {
                    cropSelect.innerHTML = '<option value="">-- Choose a crop --</option>';
                    crops.forEach(crop => {
                        const option = document.createElement('option');
                        option.value = crop.crop_id;
                        option.textContent = `${crop.crop_name} (${crop.variety})`;
                        cropSelect.appendChild(option);
                    });
                }
            } catch (error) {
                console.warn('Using embedded seed crops due to API error.', error?.message || error);
            }
        })();

        generateBtn.addEventListener('click', async () => {
            const crop_id = cropSelect.value;
            const sowing_date = sowingDateInput.value;
            if (!crop_id || !sowing_date) {
                alert('Please select a crop and a sowing date.');
                return;
            }
            buttonText.textContent = 'Generating...';
            loadingSpinner.classList.remove('hidden');
            generateBtn.disabled = true;
            try {
                const response = await fetch(`/api/generate-calendar`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ crop_id, sowing_date })
                });
                if (!response.ok) throw new Error('Network response was not ok');
                generatedEvents = await response.json();
                currentDate = new Date(sowing_date + 'T00:00:00');
                placeholderCard.classList.add('hidden');
                taskListCard.classList.remove('hidden');
                calendarCard.classList.remove('hidden');
                renderTaskList(generatedEvents);
                renderCalendar();
            } catch (error) {
                console.error('Failed to generate calendar:', error);
                alert('Could not generate schedule. Please try again.');
            } finally {
                buttonText.textContent = 'Generate Schedule';
                loadingSpinner.classList.add('hidden');
                generateBtn.disabled = false;
            }
        });

        addEventForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const newEvent = {
                date: eventDateInput.value,
                title: eventTitleInput.value,
                type: eventTypeSelect.value,
                description: 'User added task.'
            };
            generatedEvents.push(newEvent);
            renderTaskList(generatedEvents);
            renderCalendar();
            window.closeDayModal();
            eventTitleInput.value = '';
        });

        prevMonthBtn.addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar();
        });

        nextMonthBtn.addEventListener('click', () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar();
        });

        todayBtn.addEventListener('click', () => {
            currentDate = new Date();
            renderCalendar();
        });
    }

    let farmerData = {};

    async function initializeDashboard() {
        try {
            const response = await fetch(`/api/farmer-data/${farmerId}`);
            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.message || (window.t && window.t.couldNotFetchFarmerData) || 'Could not fetch farmer data');
            }
            farmerData = await response.json();

            if (!farmerData.name) {
                window.location.href = '/onboarding';
                return;
            }

            populateDashboard();

            const latestFarmDetails = farmerData.farmDetails[farmerData.farmDetails.length - 1];
            
            if (farmerData.location) {
                // Fetching weather and forecast data and then checking for alerts
                fetchAndRenderTodayWeather(farmerData.location);
                await fetchAndRenderForecast(farmerData.location);
            }
        } catch (error) {
            dashboardContent.innerHTML = `<p class="text-red-500 font-semibold">${(window.t && window.t.errorTryLoggingInAgain) || 'Error: Please try logging in again.'}</p>`;
        }
    }

    function populateDashboard() {
        userAvatar.src = `https://placehold.co/40x40/28A745/FFFFFF?text=${farmerData.name.charAt(0)}`;
        renderLeftSidebar();
        renderRightSidebar();
        renderMainContent();
    }

