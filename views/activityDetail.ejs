<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8fafc; /* slate-50 */
        }
    </style>
</head>

<body>
    <% const icons = { SOWING: 'sprout', IRRIGATION: 'watering-can', FERTILIZER: 'paper-bag-with-seeds', PESTICIDE: 'spray', PEST_SIGHTING: 'ladybird', HARVEST: 'tractor', EXPENSE: 'cash-in-hand', default: 'local_florist' }; %>
    <% const iconName = icons[activity.activityType] || icons.default; %>

    <header class="bg-white/80 backdrop-blur-lg sticky top-0 z-10 border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-6 sm:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/" class="text-2xl font-bold text-green-600">Krishi Sakhi</a>
                <nav class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-base font-medium text-gray-600 hover:text-green-600 transition-colors">Dashboard</a>
                    <a href="/activity/history" class="text-base font-medium text-gray-600 hover:text-green-600 transition-colors">History</a>
                    <!-- <a href="/profile" class="text-base font-medium text-gray-600 hover:text-green-600 transition-colors">Profile</a> -->
                </nav>
                <div class="md:hidden">
                    <button class="p-2 rounded-md hover:bg-gray-100">
                         <span class="material-icons text-gray-600">menu</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="py-10">
        <div class="max-w-4xl mx-auto px-6 sm:px-8">
            <div class="mb-6">
                 <div>
                    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight">Edit Activity</h1>
                    <p class="mt-2 text-lg text-gray-600">A complete record of all activities on your farm.</p>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="p-8 bg-slate-50 border-b border-gray-200">
                     <div class="flex items-center gap-4">
                        <div class="w-16 h-16 bg-green-100 rounded-lg flex items-center justify-center">
                            <img src="https://img.icons8.com/fluency/96/<%= iconName %>.png" alt="<%= activity.activityType %>" class="w-10 h-10"/>
                        </div>
                        <div>
                            <p class="text-base font-medium text-gray-500"><%= new Date(activity.activityDate).toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                            <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 capitalize"><%= activity.activityType.replace(/_/g, ' ').toLowerCase() %></h1>
                        </div>
                    </div>
                </div>

                <div class="p-8 space-y-8">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                        <% if (activity.materialName) { %>
                            <div>
                                <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Product Details</h3>
                                <p class="text-lg font-semibold text-gray-800 mt-1"><%= activity.materialName %></p>
                                <p class="text-base text-gray-600"><%= activity.quantity %> <%= activity.unit %></p>
                            </div>
                        <% } %>

                        <% if (activity.cost > 0) { %>
                            <div>
                                <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Cost / Value</h3>
                                <p class="text-lg font-semibold text-gray-800 mt-1">₹<%= activity.cost.toFixed(2) %></p>
                            </div>
                        <% } %>
                    </div>
                    
                    <% if (activity.description) { %>
                        <div>
                            <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Notes</h3>
                            <p class="text-base text-gray-700 mt-2 whitespace-pre-wrap"><%= activity.description %></p>
                        </div>
                    <% } %>

                    <% if (activity.receiptImageUrl) { %>
                        <div>
                            <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Receipt</h3>
                            <a href="<%= activity.receiptImageUrl %>" target="_blank" rel="noopener noreferrer">
                                <img src="<%= activity.receiptImageUrl %>" alt="Receipt" class="mt-2 rounded-lg border border-gray-200 shadow-sm max-w-xs transition-transform hover:scale-105">
                            </a>
                        </div>
                    <% } %>
                </div>

                <div class="px-8 py-6 bg-slate-50 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-end gap-4">
                     <form action="/activity/<%= activity._id %>/delete" method="POST" class="w-full sm:w-auto" onsubmit="return confirm('Are you sure you want to delete this activity? This cannot be undone.');">
                        <button type="submit" class="w-full flex items-center justify-center gap-2 bg-red-100 text-red-700 font-bold py-3 px-6 rounded-lg hover:bg-red-200 hover:text-red-800 transition-all">
                            <span class="material-icons">delete_outline</span>
                            Delete
                        </button>
                    </form>
                    <a href="/activity/<%= activity._id %>/edit" class="w-full sm:w-auto flex items-center justify-center gap-2 bg-green-600 text-white font-bold py-3 px-6 rounded-lg hover:bg-green-700 transition-all">
                        <span class="material-icons">edit</span>
                        Edit Activity
                    </a>
                </div>
            </div>
        </div>
    </main>
</body>
</html>