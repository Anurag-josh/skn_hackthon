<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>

    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8fafc; /* slate-50 */
        }
    </style>
</head>

<body>

    <% const icons = { SOWING: 'sprout', IRRIGATION: 'watering-can', FERTILIZER: 'paper-bag-with-seeds', PESTICIDE: 'spray', PEST_SIGHTING: 'ladybird', HARVEST: 'tractor', EXPENSE: 'cash-in-hand', default: 'local_florist' }; %>

    <header class="bg-white/80 backdrop-blur-lg sticky top-0 z-10 border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-6 sm:px-8">
            <div class="flex justify-between items-center h-16">
                <a href="/dashboard" class="text-2xl font-bold text-green-600">Krishi Sakhi</a>
                <nav class="hidden md:flex items-center space-x-8">
                    <a href="/" class="text-base font-medium text-gray-600 hover:text-green-600 transition-colors">Dashboard</a>
                    <a href="/activity/history" class="text-base font-medium text-green-600 transition-colors">History</a>
                    <!-- <a href="/profile" class="text-base font-medium text-gray-600 hover:text-green-600 transition-colors">Profile</a> -->
                </nav>
                <div class="md:hidden">
                    <button class="p-2 rounded-md hover:bg-gray-100">
                         <span class="material-icons text-gray-600">menu</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="py-10">
        <div class="max-w-6xl mx-auto px-6 sm:px-8">

            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-10">
                <div>
                    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight">Activity History</h1>
                    <p class="mt-2 text-lg text-gray-600">A complete record of all activities on your farm.</p>
                </div>
                <a href="/activity/log" class="flex-shrink-0 w-full md:w-auto flex items-center justify-center gap-2 bg-green-600 text-white font-bold py-3 px-6 rounded-lg hover:bg-green-700 transition-all">
                    <span class="material-icons">add_circle</span>
                    Log New Activity
                </a>
            </div>

            <% if (activities.length > 0) { %>
                <div class="space-y-6">
                    <% activities.forEach(activity => { %>
                        <% const iconName = icons[activity.activityType] || icons.default; %>
                        <a href="/activity/<%= activity._id %>" class="block bg-white rounded-2xl shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                            <div class="flex items-center">
                                <div class="w-32 text-center p-6 bg-slate-50 border-r border-gray-200">
                                    <img src="https://img.icons8.com/fluency/96/<%= iconName %>.png" alt="<%= activity.activityType %>" class="w-16 h-16 mx-auto mb-2"/>
                                    <h2 class="font-bold text-base text-gray-800 capitalize"><%= activity.activityType.replace(/_/g, ' ').toLowerCase() %></h2>
                                </div>
                                
                                <div class="flex-grow p-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-4">
                                    <div>
                                        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Date</h3>
                                        <p class="text-base font-semibold text-gray-800 mt-1"><%= new Date(activity.activityDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
                                    </div>
                                    
                                    <% if (activity.materialName) { %>
                                    <div>
                                        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Product</h3>
                                        <p class="text-base font-semibold text-gray-800 mt-1 truncate"><%= activity.materialName %></p>
                                    </div>
                                    <% } %>

                                    <% if (activity.cost > 0) { %>
                                    <div>
                                        <h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Cost / Value</h3>
                                        <p class="text-base font-semibold text-gray-800 mt-1">₹<%= activity.cost.toFixed(2) %></p>
                                    </div>
                                    <% } %>
                                </div>

                                <div class="px-6 text-gray-300">
                                    <span class="material-icons">chevron_right</span>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="bg-white p-12 rounded-2xl shadow-lg text-center">
                    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto">
                         <span class="material-icons text-4xl text-green-600">eco</span>
                    </div>
                    <h2 class="mt-6 text-2xl font-bold text-gray-800">Your Farm is a Blank Canvas</h2>
                    <p class="mt-2 text-base text-gray-500">You haven't logged any activities yet. Start by recording your first one!</p>
                </div>
            <% } %>
        </div>
    </main>
</body>
</html>