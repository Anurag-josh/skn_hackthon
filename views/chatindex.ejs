            };
            const farmData = {
                en: { states: { 'Maharashtra': { cities: ['Solapur', 'Pune', 'Nagpur', 'Nashik'] }, 'Karnataka': { cities: ['Bengaluru', 'Mysuru', 'Hubballi'] }, 'Punjab': { cities: ['Amritsar', 'Ludhiana', 'Jalandhar'] }, 'Kerala': { cities: ['Kochi', 'Thiruvananthapuram', 'Kozhikode'] } }, crops: ['Sugarcane', 'Cotton', 'Rice', 'Banana', 'Wheat', 'Coconut'] },
                mr: { states: { 'महाराष्ट्र': { cities: ['सोलापूर', 'पुणे', 'नागपूर', 'नाशिक'] }, 'कर्नाटक': { cities: ['बंगळूर', 'म्हैसूर', 'हुबळी'] }, 'पंजाब': { cities: ['अमृतसर', 'लुधियाना', 'जालंधर'] }, 'केरळ': { cities: ['कोची', 'तिरुवनंतपुरम', 'कोझिकोड'] } }, crops: ['ऊस', 'कापूस', 'तांदूळ', 'केळी', 'गहू', 'नारळ'] },
                hi: { states: { 'महाराष्ट्र': { cities: ['सोलापुर', 'पुणे', 'नागपुर', 'नासिक'] }, 'कर्नाटक': { cities: ['बेंगलुरु', 'मैसूर', 'हुबली'] }, 'पंजाब': { cities: ['अमृतसर', 'लुधियाना', 'जालंधर'] }, 'केरल': { cities: ['कोच्चि', 'तिरुवनंतपुरम', 'कोझिकोड'] } }, crops: ['गन्ना', 'कपास', 'चावल', 'केला', 'गेहूं', 'नारियल'] },
                ml: { states: { 'മഹാരാഷ്ട്ര': { cities: ['സോലാപ്പൂർ', 'പൂനെ', 'നാഗ്പൂർ', 'നാസിക്'] }, 'കർണാടക': { cities: ['ബെംഗളൂരു', 'മൈസൂരു', 'ഹുബ്ബള്ളി'] }, 'പഞ്ചാബ്': { cities: ['അമൃത്സർ', 'ലൂധിയാന', 'ജലന്ധർ'] }, 'കേരളം': { cities: ['കൊച്ചി', 'തിരുവനന്തപുരം', 'കോഴിക്കോട്'] } }, crops: ['കരിമ്പ്', 'പരുത്തി', 'അരി', 'വാഴ', 'ഗോതമ്പ്', 'തേങ്ങ'] }
            };
            const simulatedFarmers = { en: ['Suresh', 'Meena', 'Gopal'], mr: ['सुरेश', 'मीना', 'गोपाळ'], hi: ['सुरेश', 'मीना', 'गोपाल'], ml: ['സുരേഷ്', 'മീന', 'ഗോപാൽ'] };
            const farmMessages = {
                en: ['Fertilizer prices seem high this season.', 'Has anyone tried the new seed variety?', 'Expecting rain tomorrow, be careful.', 'My crop is showing signs of pest attack.'],
                mr: ['या हंगामात खतांचे भाव वाढलेले दिसतात.', 'नवीन बियाण्याचा प्रकार कोणी वापरून पाहिला आहे का?', 'उद्या पावसाची अपेक्षा आहे, काळजी घ्या.', 'माझ्या पिकावर कीटकांचा प्रादुर्भाव दिसून येत आहे.'],
                hi: ['इस मौसम में उर्वरक की कीमतें ऊंची लगती हैं।', 'क्या किसी ने नई बीज की किस्म आजमाई है?', 'कल बारिश की उम्मीद है, सावधान रहें।', 'मेरी फसल में कीट के हमले के लक्षण दिख रहे हैं।'],
                ml: ['ഈ സീസണിൽ വളത്തിന്റെ വില കൂടുതലാണെന്ന് തോന്നുന്നു.', 'പുതിയ വിത്ത് ആരെങ്കിലും പരീക്ഷിച്ചിട്ടുണ്ടോ?', 'നാളെ മഴ പ്രതീക്ഷിക്കുന്നു, ശ്രദ്ധിക്കുക.', 'എന്റെ വിളയിൽ കീടങ്ങളുടെ ആക്രമണത്തിന്റെ ലക്ഷണങ്ങൾ കാണിക്കുന്നു.']
            };
            const appData = { communities: {} };

            // --- Formatting Helpers ---
            const formatNumber = (num, lang) => new Intl.NumberFormat(locales[lang]).format(num);

            // --- Core Functions ---
            const setLanguage = (lang) => {
                currentLang = lang;
                const langTranslations = translations[lang];
                if (!langTranslations) return;
                langSwitchers.forEach(s => s.value = lang);
                document.querySelectorAll('[data-translate-key]').forEach(el => {
                    const key = el.dataset.translateKey;
                    if (langTranslations[key]) el.textContent = langTranslations[key];
                });
                document.querySelectorAll('[data-translate-key-placeholder]').forEach(el => {
                    const key = el.dataset.translateKeyPlaceholder;
                    if (langTranslations[key]) el.placeholder = langTranslations[key];
                });
                renderStates();
                if (userSelection.state) renderCities(userSelection.state, true);
                if (userSelection.crop) renderCrops(true);
                if (screens.login.classList.contains('active')) renderDashboard();
                if (screens.chatApp.classList.contains('active')) renderAll();
            };

            const navigateToOnboarding = (screenName) => {
                Object.values(screens).forEach(s => s.classList.remove('active', 'flex'));
                screens[screenName].classList.add('active', 'flex');
                if (screenName === 'login') renderDashboard();
            };

            const showMainView = (viewName) => {
                Object.values(mainViews).forEach(v => v.classList.remove('active', 'flex-col'));
                mainViews[viewName].classList.add('active', 'flex-col');
            };

            const createButton = (text, onClick) => {
                const button = document.createElement('button');
                button.className = 'w-full text-left p-3 hover:bg-gray-100 transition duration-200 rounded-lg text-gray-700';
                button.textContent = text;
                button.addEventListener('click', onClick);
                return button;
            };

            const renderStates = () => {
                lists.state.innerHTML = '';
                const currentFarmData = farmData[currentLang];
                Object.keys(currentFarmData.states).forEach(state => {
                    lists.state.appendChild(createButton(state, () => {
                        const originalState = Object.keys(farmData.en.states)[Object.keys(currentFarmData.states).indexOf(state)];
                        userSelection.state = originalState;
                        renderCities(originalState);
                        navigateToOnboarding('city');
                    }));
                });
            };

            const renderCities = (stateKey, isLanguageChange = false) => {
                lists.city.innerHTML = '';
                const stateIndex = Object.keys(farmData.en.states).indexOf(stateKey);
                const translatedStateKey = Object.keys(farmData[currentLang].states)[stateIndex];
                const cities = farmData[currentLang].states[translatedStateKey].cities;
                const originalCities = farmData.en.states[stateKey].cities;
                cities.forEach((city, index) => {
                    lists.city.appendChild(createButton(city, () => {
                        userSelection.city = originalCities[index];
                        renderCrops();
                        navigateToOnboarding('crop');
                    }));
                });
                if (isLanguageChange) renderCrops(true);
            };

            const renderCrops = (isLanguageChange = false) => {
                lists.crop.innerHTML = '';
                const crops = farmData[currentLang].crops;
                const originalCrops = farmData.en.crops;
                crops.forEach((crop, index) => {
                    lists.crop.appendChild(createButton(crop, () => {
                        userSelection.crop = originalCrops[index];
                        updateJoiningCommunityName();
                        navigateToOnboarding('login');
                        usernameInput.focus();
                    }));
                });
                if (isLanguageChange) updateJoiningCommunityName();
            };

            const updateJoiningCommunityName = () => {
                if (!userSelection.state || !userSelection.city || !userSelection.crop) return;
                const communityId = `#${userSelection.state}-${userSelection.city}-${userSelection.crop}`;
                joiningCommunityName.textContent = communityId;
            }

            const renderCommunityList = () => {
                lists.community.innerHTML = '';
                const searchTerm = searchInput.value.toLowerCase();
                let communities = Object.keys(appData.communities).filter(name => name.toLowerCase().includes(searchTerm));
                communities.sort((a, b) => sortSelect.value === 'az' ? a.localeCompare(b) : b.localeCompare(a));
                if (communities.length === 0) lists.community.innerHTML = `<li class="p-2 text-gray-500 text-sm">${translations[currentLang].noCommunities}</li>`;
                communities.forEach(name => {
                    const li = document.createElement('li');
                    const isActive = name === currentCommunity;
                    li.innerHTML = `<a href="#" class="flex items-center justify-between p-3 rounded-lg transition ${isActive ? 'bg-green-500 text-white shadow' : 'hover:bg-gray-100 text-gray-700'}"><span class="text-sm font-semibold break-all">${name}</span><span id="dot-${name.replace(/#/g, '')}" class="hidden notification-dot"></span></a>`;
                    li.querySelector('a').addEventListener('click', (e) => { e.preventDefault(); switchCommunity(name); });
                    lists.community.appendChild(li);
                });
            };

            const renderMessages = () => {
                messagesContainer.innerHTML = '';
                const community = appData.communities[currentCommunity];
                if (!community || !community.messages || community.messages.length === 0) {
                    messagesContainer.innerHTML = `<div class="text-center text-gray-400 mt-4">${translations[currentLang].noMessages}</div>`;
                    return;
                }
                community.messages.forEach(msg => {
                    const isCurrentUser = msg.sender === currentUser;
                    const messageEl = document.createElement('div');
                    messageEl.className = `flex mb-4 items-end ${isCurrentUser ? 'justify-end' : 'justify-start'} animate-slide-in-up`;
                    messageEl.innerHTML = `
                        <div class="max-w-xs md:max-w-md">
                            <div class="text-xs text-gray-400 mb-1 ${isCurrentUser ? 'text-right' : 'text-left'}">${msg.sender}</div>
                            <div class="px-4 py-3 rounded-2xl ${isCurrentUser ? 'bg-green-500 text-white rounded-br-none' : 'bg-white text-gray-800 rounded-bl-none border border-gray-200'}">
                                <p class="break-words">${msg.text}</p>
                            </div>
                            <div class="text-xs text-gray-400 mt-1 ${isCurrentUser ? 'text-right' : 'text-left'}">${msg.timestamp}</div>
                        </div>`;
                    messagesContainer.appendChild(messageEl);
                });
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
                const dot = document.getElementById(`dot-${currentCommunity.replace(/#/g, '')}`);
                if (dot) dot.classList.add('hidden');
            };

            const renderDashboard = () => {
                const trending = Object.entries(appData.communities).map(([name, data]) => ({ name, score: ((data.users?.length || 0) * 3) + (data.messages?.length || 0) })).sort((a, b) => b.score - a.score).slice(0, 3);
                trendingCommunitiesList.innerHTML = '';
                if (trending.length === 0) {
                    trendingCommunitiesList.innerHTML = `<p class="text-gray-400">${translations[currentLang].noTrending}</p>`;
                } else {
                    trending.forEach(comm => {
                        const div = document.createElement('div');
                        div.className = 'flex justify-between items-center bg-gray-100 hover:bg-gray-200 p-3 rounded-lg transition duration-300';
                        div.innerHTML = `<span class="font-semibold text-sm break-all text-gray-700">${comm.name}</span><button data-community-name="${comm.name}" class="join-trending-btn bg-green-500 hover:bg-green-600 text-white text-sm font-bold py-1 px-3 rounded-md transition transform hover:scale-105 active:scale-100">${translations[currentLang].join}</button>`;
                        trendingCommunitiesList.appendChild(div);
                    });
                }
            };

            const updateHeader = () => {
                communityName.textContent = currentCommunity;
                const userList = appData.communities[currentCommunity]?.users || [];
                userCount.textContent = `${formatNumber(userList.length, currentLang)} ${translations[currentLang].membersOnline}`;
            };

            const switchCommunity = (name) => {
                if (currentCommunity === name) { return; }
                if (appData.communities[currentCommunity]) {
                    const oldUsers = appData.communities[currentCommunity].users;
                    appData.communities[currentCommunity].users = oldUsers.filter(u => u !== currentUser);
                }
                currentCommunity = name;
                if (!appData.communities[currentCommunity]) {
                    appData.communities[currentCommunity] = { users: [], messages: [] };
                }
                if (!appData.communities[currentCommunity].users.includes(currentUser)) {
                    appData.communities[currentCommunity].users.push(currentUser);
                }
                renderAll();
            };

            const renderAll = () => { renderCommunityList(); updateHeader(); renderMessages(); };

            const handleLogin = (e) => {
                e.preventDefault();
                const username = usernameInput.value.trim();
                const communityId = `#${userSelection.state}-${userSelection.city}-${userSelection.crop}`;
                if (username) {
                    currentUser = username;
                    currentCommunity = communityId;
                    if (!appData.communities[currentCommunity]) {
                        appData.communities[currentCommunity] = { users: [], messages: [] };
                    }
                    if (!appData.communities[currentCommunity].users.includes(currentUser)) {
                        appData.communities[currentCommunity].users.push(currentUser);
                    }
                    usernameDisplay.textContent = currentUser;
                    userAvatar.textContent = currentUser.charAt(0).toUpperCase();
                    navigateToOnboarding('chatApp');
                    renderAll();
                    showMainView('chat');
                    if (!simulationStarted) {
                        startSimulation();
                        simulationStarted = true;
                    }
                }
            };

            const handleSendMessage = (e) => {
                e.preventDefault();
                const text = messageInput.value.trim();
                if (text) {
                    const newMessage = { sender: currentUser, text, timestamp: new Date().toLocaleTimeString(locales[currentLang], { hour: '2-digit', minute: '2-digit' }) };
                    appData.communities[currentCommunity].messages.push(newMessage);
                    renderMessages();
                    messageInput.value = '';
                }
            };

            const startSimulation = () => {
                setInterval(() => {
                    const communities = Object.keys(appData.communities);
                    if (communities.length === 0) return;
                    const randomCommunity = communities[Math.floor(Math.random() * communities.length)];
                    const farmer = simulatedFarmers[currentLang][Math.floor(Math.random() * simulatedFarmers[currentLang].length)];
                    const msg = farmMessages[currentLang][Math.floor(Math.random() * farmMessages[currentLang].length)];
                    if (!appData.communities[randomCommunity].users.includes(farmer)) appData.communities[randomCommunity].users.push(farmer);
                    appData.communities[randomCommunity].messages.push({ sender: farmer, text: msg, timestamp: new Date().toLocaleTimeString(locales[currentLang], { hour: '2-digit', minute: '2-digit' }) });
                    if (screens.chatApp.classList.contains('active')) renderAll();
                    if (randomCommunity !== currentCommunity) {
                        const dot = document.getElementById(`dot-${randomCommunity.replace(/#/g, '')}`);
                        if (dot) dot.classList.remove('hidden');
                    }
                }, 8000);
            };

            // --- Event Listeners ---
            loginForm.addEventListener('submit', handleLogin);
            messageForm.addEventListener('submit', handleSendMessage);
            searchInput.addEventListener('input', renderCommunityList);
            sortSelect.addEventListener('change', renderCommunityList);
            buttons.backToStates.addEventListener('click', () => navigateToOnboarding('state'));
            buttons.backToCities.addEventListener('click', () => navigateToOnboarding('city'));
            buttons.backToCrops.addEventListener('click', () => navigateToOnboarding('crop'));
            trendingCommunitiesList.addEventListener('click', (e) => {
                if (e.target.classList.contains('join-trending-btn')) {
                    const communityToJoin = e.target.dataset.communityName;
                    const [_, state, city, crop] = communityToJoin.split('-');
                    userSelection.state = state;
                    userSelection.city = city;
                    userSelection.crop = crop;
                    updateJoiningCommunityName();
                }
            });
            langSwitchers.forEach(s => s.addEventListener('change', (e) => setLanguage(e.target.value)));
            emojiButton.addEventListener('click', (e) => { e.stopPropagation(); emojiPicker.classList.toggle('hidden'); });
            emojiPicker.addEventListener('emoji-click', event => { messageInput.value += event.detail.unicode; });
            document.addEventListener('click', (e) => {
                if (!emojiPicker.contains(e.target) && e.target !== emojiButton) {
                    emojiPicker.classList.add('hidden');
                }
            });

            // --- Initial Render ---
            setLanguage('en');
        });
    </script>
</body>
</html> 