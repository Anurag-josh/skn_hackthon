            searchBar.addEventListener('input', renderProducts);
            filterButtons.addEventListener('click', (e) => {
                if (e.target.tagName === 'BUTTON') {
                    currentFilter = e.target.dataset.filter;
                    document.querySelectorAll('.filter-btn').forEach(btn => {
                        btn.classList.remove('bg-green-500', 'text-white');
                        btn.classList.add('bg-gray-200', 'text-gray-700');
                    });
                    e.target.classList.add('bg-green-500', 'text-white');
                    e.target.classList.remove('bg-gray-200', 'text-gray-700');
                    renderProducts();
                }
            });
            cartItemsContainer.addEventListener('click', (e) => {
                if (e.target.classList.contains('remove-from-cart-btn')) {
                    removeFromCart(parseInt(e.target.dataset.id));
                }
            });
            cartButton.addEventListener('click', () => {
                profileSidebar.classList.remove('active');
                cartSidebar.classList.add('active', 'animate-slide-in-right');
            });
            closeCartBtn.addEventListener('click', () => cartSidebar.classList.remove('active'));
            profileButton.addEventListener('click', () => {
                cartSidebar.classList.remove('active');
                profileSidebar.classList.add('active', 'animate-slide-in-right');
                renderMyOrders();
            });
            closeProfileBtn.addEventListener('click', () => profileSidebar.classList.remove('active'));
            checkoutBtn.addEventListener('click', () => openCheckout(cart));
            closeCheckoutBtn.addEventListener('click', () => checkoutModal.classList.remove('active'));
            closeSuccessBtn.addEventListener('click', () => successModal.classList.remove('active'));
            paymentOptions.addEventListener('click', (e) => {
                const target = e.target.closest('button');
                if (target) handlePayment(target.dataset.method);
            });

            // --- Initializer ---
            const initializeApp = () => {
                fetchProducts();
                setLanguage('en'); // Set default language on load
            };
            initializeApp();
        });
    </script>
</body>

</html>