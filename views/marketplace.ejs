<html>
  <head>
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="" />
    <link
      rel="stylesheet"
      as="style"
      onload="this.rel='stylesheet'"
      href="https://fonts.googleapis.com/css2?display=swap&family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@400;500;600;700"
    />
    <title>Marketplace - GardenGenius</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64," />
    <!-- tailwindcss -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              'plant-green': '#17cf1d',
              'plant-dark': '#0e1b0e',
              'plant-light': '#f9fbf9',
              'plant-accent': '#14b714',
              'plant-muted': '#608560',
              'plant-bg': '#eaf0ea'
            },
            fontFamily: {
              'inter': ['Inter', 'sans-serif'],
              'poppins': ['Poppins', 'sans-serif']
            }
          }
        }
      }
    </script>
    <!-- Style  -->
    <style>
      @keyframes leafSway {
        0%, 100% { transform: rotate(-2deg); }
        50% { transform: rotate(2deg); }
      }
      
      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      
      .leaf-sway {
        animation: leafSway 3s ease-in-out infinite;
      }
      
      .fade-in-up {
        animation: fadeInUp 0.4s ease-out;
      }
      
      .gradient-bg {
        background: linear-gradient(135deg, #f9fbf9 0%, #eaf0ea 100%);
      }
      
      .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
      }
      
      .price-badge {
        background: linear-gradient(135deg, #17cf1d 0%, #14b714 100%);
      }
      
      /* Dropdown fixes */
      select {
        position: relative;
        z-index: 1000;
      }
      
      select:focus {
        z-index: 1001;
      }
      
      .filter-card {
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
        position: relative;
        z-index: 100;
      }
    </style>
  </head>
  <body class="font-inter">
    <div class="relative flex size-full min-h-screen flex-col gradient-bg overflow-x-hidden">
      <!-- Header -->
      <header class="sticky top-0 z-50 backdrop-blur-lg bg-white/80 border-b border-plant-bg shadow-sm">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <div class="flex items-center gap-3 text-plant-dark">
              <div class="size-8 leaf-sway">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M44 4H30.6666V17.3334H17.3334V30.6666H4V44H44V4Z" fill="currentColor" />
                </svg>
              </div>
              <h1 class="text-xl font-bold font-poppins tracking-tight hidden sm:block">GardenGenius</h1>
            </div>
            
            <!-- Dashboard Button -->
            <div class="flex items-center gap-4">
              <a href="/" class="hidden sm:block">
                <button class="flex items-center justify-center px-6 py-2 bg-plant-green hover:bg-plant-accent text-white font-semibold rounded-full transition-all duration-200 hover:scale-105 shadow-lg">
                  <span>Dashboard</span>
                </button>
              </a>
              <!-- Mobile menu button -->
              <button class="sm:hidden p-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Alert Message -->
      <% if (userMessage) { %>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 mt-4">
          <div class="flex items-center gap-3 bg-red-50 text-red-700 border border-red-200 rounded-xl px-4 py-3 shadow-sm">
            <span class="text-xl flex-shrink-0">⚠</span>
            <span class="text-sm"><%= userMessage %></span>
          </div>
        </div>
      <% } %>

      <!-- Main Content -->
      <main class="flex-1 container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Hero Section -->
        <div class="text-center mb-12 fade-in-up">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-plant-dark mb-4 font-poppins">
            🌱 Marketplace
          </h2>
          <p class="text-plant-muted text-lg sm:text-xl max-w-2xl mx-auto mb-2">
            Track Daily Crop Prices Across Maharashtra Markets
          </p>
          <% if (dataDate) { %>
            <div class="inline-flex items-center gap-2 bg-plant-green/10 text-plant-dark px-4 py-2 rounded-full text-sm font-medium">
              <span class="w-2 h-2 bg-plant-green rounded-full"></span>
              Showing data for: <%= dataDate %>
            </div>
          <% } %>
        </div>

        <!-- Filter Section -->
        <div class="mb-8 fade-in-up">
          <div class="filter-card rounded-2xl border border-plant-bg/50 p-6 shadow-lg">
            <h3 class="text-lg font-semibold text-plant-dark mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.414A1 1 0 013 6.707V4z"></path>
