<!DOCTYPE html>

<html lang="en">
<!-- rotation_planer -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title data-key="page_title">Crop Rotation Planner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Sans', sans-serif;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in-up {
            animation: fadeInUp 0.6s ease-out forwards;
        }
    </style>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <div class="w-full max-w-2xl">
        <div class="bg-white rounded-2xl shadow-2xl p-8">
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-green-600" data-key="main_title">Farmer's Crop Rotation Planner</h1>
                <p class="text-gray-500 mt-2" data-key="subtitle">Get intelligent advice for your next crop cycle.</p>
            </div>

            <div class="mb-6">
                <label for="lang-select" class="block text-sm font-medium text-gray-700 mb-1" data-key="select_language_label">Choose Language</label>
                <select id="lang-select" class="w-full bg-gray-100 border-2 border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-green-500 transition">
                    <option value="en">English</option>
                    <option value="hi">हिन्दी (Hindi)</option>
                    <option value="mr">मराठी (Marathi)</option>
                    <option value="ml">മലയാളം (Malayalam)</option>
                </select>
            </div>

            <form id="advisor-form" class="space-y-6">
                <div>
                    <label for="current-crop" class="block text-sm font-medium text-gray-700 mb-1" data-key="select_crop_label">Select Your Current Crop</label>
                    <select id="current-crop" class="w-full bg-gray-100 border-2 border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-green-500 transition"></select>
                </div>
                <div>
                    <button type="submit" class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-4 rounded-lg transition transform hover:scale-105 active:scale-100" data-key="get_advice_button">Get Advice</button>
                </div>
            </form>
        </div>

        <div id="recommendation-card" class="bg-white rounded-2xl shadow-2xl p-8 mt-8 hidden">
            </div>

    </div>

