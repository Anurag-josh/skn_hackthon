                        "Cardamom": { name: "ഏലം (മലബാർ)", next_crop: "തണൽ നൽകുന്ന മരങ്ങൾ (ഇടവിള)", benefit: "സന്തുലിതമായ ഒരു ആവാസവ്യവസ്ഥ നിലനിർത്തുകയും ഏലത്തിന് ആവശ്യമായ തണൽ നൽകുകയും ചെയ്യുന്നു." },
                        "Bitter Gourd": { name: "പാവൽ (പ്രീതി)", next_crop: "ചെണ്ടുമല്ലി", benefit: "ചെണ്ടുമല്ലിയുടെ വേരുകൾ പാവലിന് സാധാരണയായി കാണുന്ന കീടമായ നിമവിരകളെ നിയന്ത്രിക്കുന്ന സംയുക്തങ്ങൾ പുറത്തുവിടുന്നു." },
                        "Okra": { name: "വെണ്ട (അർക്ക അനാമിക)", next_crop: "ബീൻസ് (ബുഷ് ബീൻസ്)", benefit: "ബീൻസ് നൈട്രജൻ ഉറപ്പിക്കുന്നു, ഇത് അടുത്ത വെണ്ട കൃഷിക്ക് പ്രയോജനകരമാണ്." },
                        "Tomato": { name: "തക്കാളി (ശക്തി)", next_crop: "ഉള്ളി അല്ലെങ്കിൽ വെളുത്തുള്ളി", benefit: "തക്കാളിയെ ബാധിക്കുന്ന സാധാരണ മണ്ണിലൂടെ പകരുന്ന രോഗങ്ങളെ നിയന്ത്രിക്കാൻ സഹായിക്കുന്നു." },
                        "Cucumber": { name: "വെള്ളരി (അരുണിമ)", next_crop: "മുള്ളങ്കി", benefit: "മുള്ളങ്കിക്ക് ആഴത്തിലുള്ള വേരുകളുണ്ട്, ഇത് ഉറച്ച മണ്ണിനെ അയവുള്ളതാക്കാനും വായുസഞ്ചാരം നൽകാനും സഹായിക്കുന്നു." },
                        "Elephant Foot Yam": { name: "ചേന (ഗജേന്ദ്ര)", next_crop: "ചെറുപയർ", benefit: "അടുത്ത ചേന സീസണിന് മുമ്പ് നൈട്രജൻ ഉറപ്പിക്കുന്ന ഒരു ഹ്രസ്വകാല പയർവർഗ്ഗ വിള." },
                        "Pineapple": { name: "പൈനാപ്പിൾ (ക്യൂ)", next_crop: "പയർവർഗ്ഗങ്ങൾ (ആവരണ വിളയായി)", benefit: "മണ്ണൊലിപ്പ് തടയുകയും പൈനാപ്പിൾ ചക്രങ്ങൾക്കിടയിൽ മണ്ണിൽ നൈട്രജൻ ചേർക്കുകയും ചെയ്യുന്നു." },
                        "Jackfruit": { name: "പ്ലാവ് (ഓൾ സീസൺ)", next_crop: "ആവരണ വിളകൾ (കലോപോഗോണിയം)", benefit: "കളകളെ ഫലപ്രദമായി നിയന്ത്രിക്കുകയും മരങ്ങൾക്ക് ചുറ്റുമുള്ള മണ്ണിനെ സമ്പുഷ്ടമാക്കുകയും ചെയ്യുന്നു." },
                        "Mango": { name: "മാവ് (നീലം)", next_crop: "പച്ചക്കറികൾ (ആദ്യ വർഷങ്ങളിൽ)", benefit: "മരങ്ങൾ വളരുന്നതിന് മുമ്പ് നേരത്തെയുള്ള വരുമാനം നൽകുകയും ഭൂമി കാര്യക്ഷമമായി ഉപയോഗിക്കുകയും ചെയ്യുന്നു." },
                        "Coffee": { name: "കാപ്പി (റോബസ്റ്റ)", next_crop: "കുരുമുളക് വള്ളികൾ", benefit: "കൂടുതൽ വരുമാനത്തിനായി വൈവിധ്യമാർന്ന, ബഹുനില വിള സമ്പ്രദായം സൃഷ്ടിക്കുന്നു." },
                        "Arecanut": { name: "കവുങ്ങ് (മംഗള)", next_crop: "വാഴ അല്ലെങ്കിൽ കൊക്കോ (ഇടവിള)", benefit: "അധിക വരുമാനത്തിനായി ഇടത്തരം സ്ഥലം ഉപയോഗിക്കുകയും സൂക്ഷ്മ കാലാവസ്ഥ മെച്ചപ്പെടുത്തുകയും ചെയ്യുന്നു." }
                    }
                }
            };

            let currentLang = 'en';

            const getTranslatedText = (key) => translations[currentLang][key] || key;

            const populateCrops = () => {
                currentCropSelect.innerHTML = ''; // Clear existing options
                const translatedCrops = translations[currentLang].crops;
                for (const key in translatedCrops) {
                    const option = document.createElement('option');
                    option.value = key; // Use the English key as the value for consistency
                    option.textContent = translatedCrops[key].name;
                    currentCropSelect.appendChild(option);
                }
            };

            const changeLanguage = (lang) => {
                currentLang = lang;
                document.querySelectorAll('[data-key]').forEach(element => {
                    const key = element.getAttribute('data-key');
                    const translation = getTranslatedText(key);
                    if (translation) {
                        if (element.tagName === 'TITLE') {
                            document.title = translation;
                        } else {
                            element.textContent = translation;
                        }
                    }
                });
                populateCrops();
                recommendationCard.classList.add('hidden'); // Hide recommendation on language change
            };

            const calculateTimeline = (rule, cropKey) => {
                const currentDate = new Date();
                const harvestDate = new Date(currentDate);
                harvestDate.setMonth(currentDate.getMonth() + rule.duration_months);
                const sowDate = new Date(harvestDate);
                sowDate.setMonth(harvestDate.getMonth() + rule.gap_months);
                const harvestMonth = harvestDate.toLocaleString('default', { month: 'long', year: 'numeric' });
                const sowMonth = sowDate.toLocaleString('default', { month: 'long', year: 'numeric' });

                const currentCropName = translations[currentLang].crops[cropKey].name.split(' ')[0];
                const nextCropName = translations[currentLang].crops[cropKey].next_crop;

                if (rule.duration_months === 0) {
                    return getTranslatedText('timeline_intercrop').replace('{crop}', currentCropName);
                }

                let timeline = getTranslatedText('timeline_harvest').replace('{crop}', currentCropName).replace('{date}', harvestMonth);
                timeline += ` → ${getTranslatedText('timeline_wait').replace('{months}', rule.gap_months)}`;
                timeline += ` → ${getTranslatedText('timeline_sow').replace('{crop}', nextCropName).replace('{date}', sowMonth)}`;

                return timeline;
            };

            const displayRecommendation = (cropKey) => {
                const rule = cropData[cropKey];
                const translatedRule = translations[currentLang].crops[cropKey];
                const translatedTerms = translations[currentLang].terms;

                const timeline = calculateTimeline(rule, cropKey);
                const waterColors = { "Low": "text-blue-500", "Medium": "text-yellow-600", "High": "text-red-500" };

                recommendationCard.innerHTML = `
                    <div class="text-center animate-fade-in-up">
                        <p class="text-gray-500">${getTranslatedText('recommendation_prefix').replace('{crop}', translatedRule.name)}</p>
                        <h2 class="text-4xl font-extrabold text-green-600 my-2">${translatedRule.next_crop}</h2>
                        <p class="text-lg text-gray-700 font-medium">${translatedRule.benefit}</p>
                        
                        <div class="mt-6 bg-green-500 text-white rounded-lg p-4 text-center font-semibold text-base md:text-lg">
                            ${timeline}
                        </div>

                        <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4 text-left">
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <p class="text-sm font-bold text-gray-500">${getTranslatedText('card_duration')}</p>
                                <p class="text-lg font-semibold">${rule.duration_months > 0 ? rule.duration_months + ' ' + getTranslatedText('card_months') : getTranslatedText('card_perennial')}</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <p class="text-sm font-bold text-gray-500">${getTranslatedText('card_water')}</p>
                                <p class="text-lg font-semibold ${waterColors[rule.water_requirement]}">${translatedTerms[rule.water_requirement]}</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <p class="text-sm font-bold text-gray-500">${getTranslatedText('card_soil')}</p>
                                <p class="text-lg font-semibold">${translatedTerms[rule.soil_impact]}</p>
                            </div>
                            <div class="bg-gray-50 p-4 rounded-lg">
                                <p class="text-sm font-bold text-gray-500">${getTranslatedText('card_nutrients')}</p>
                                <p class="text-lg font-semibold">${translatedTerms[rule.nutrient_contribution]}</p>
                            </div>
                        </div>

                        <div class="mt-6 bg-blue-50 rounded-lg p-4 text-left">
                            <h4 class="font-bold text-blue-800 mb-2">${getTranslatedText('card_weather_title')}</h4>
                            <div class="flex items-center gap-4">
                                <img src="https://openweathermap.org/img/wn/04d@2x.png" alt="Weather icon" class="w-12 h-12">
                                <div>
                                    <p class="font-semibold text-gray-700">29.5°C with overcast clouds</p>
                                    <p class="text-sm text-gray-600">${getTranslatedText('card_weather_desc')}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                recommendationCard.classList.remove('hidden');
            };

            advisorForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const selectedCropKey = currentCropSelect.value;
                
                recommendationCard.innerHTML = `<p class="text-center text-gray-500">${getTranslatedText('analyzing_text')}</p>`;
                recommendationCard.classList.remove('hidden');

                setTimeout(() => {
                    if (selectedCropKey) {
                        displayRecommendation(selectedCropKey);
                    }
                }, 500);
            });
            
            languageSelector.addEventListener('change', (event) => {
                changeLanguage(event.target.value);
            });

            // Initial setup on page load
            changeLanguage('en');
        });
    </script>
</body>
</html> 